NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cab_management_erp
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cab ERP <billing@example.com>
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
ENABLE_EMAIL_POLLING=false
GST_PERCENT=18
